# LLM Provider Selection (REQUIRED)
# Choose ONE chat provider: vllm, kimi, or deepseek
LLM_PROVIDER=vllm
DEFAULT_LLM_PROVIDER=vllm

# vLLM (OpenAI-compatible endpoint)
VLLM_BASE_URL=http://host.docker.internal:18000/v1
VLLM_REQUEST_TIMEOUT=120
VLLM_MODEL=Qwen3.8-27B
VLLM_API_KEY=none

# Kimi
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6

# Local file and vector storage
LOCAL_UPLOAD_DIR=./uploads
EMBEDDING_PROVIDER=hashing
USE_OPENAI_EMBEDDINGS=false
NALAMAP_GEOSERVER_VECTOR_DB=./data/geoserver_vectors.db
NALAMAP_GEOSERVER_EMBEDDING_FACTORY=
# Optional local embedding factory returning langchain_core.embeddings.Embeddings:
# NALAMAP_GEOSERVER_EMBEDDING_FACTORY=my_embeddings:create_embeddings

# Database Configuration
# Local PostGIS services created by docker-compose.yml.
DATABASE_URL=postgresql://app:app@db:5432/app
# Geodata DB for user-independent layer data (PostGIS spatial tables +
# dataset_resources catalog). Uses the local "layers" database.
GEODATA_DATABASE_URL=postgresql://app:app@db:5432/layers

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# New accounts require a matching one-time invitation by default.
# Supported values: closed, invite, open
REGISTRATION_MODE=invite
SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: required to enable Tianditu basemap options in the frontend.
NEXT_PUBLIC_TIANDITU_TOKEN=

# LangSmith Tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_project_name
# Optional when the API key requires an explicit workspace:
# LANGSMITH_WORKSPACE_ID=your_workspace_uuid
# Setup and manual scoring: docs/langsmith-evaluation.md

# Embedding Progress Configuration
# Enable/disable smooth interpolation of embedding progress (default: false)
NEXT_PUBLIC_EMBEDDING_INTERPOLATION_ENABLED=false
# Polling interval in milliseconds for checking embedding status (default: 3000)
NEXT_PUBLIC_EMBEDDING_POLLING_INTERVAL_MS=3000
# Default velocity for interpolation in layers per second (default: 3)
NEXT_PUBLIC_EMBEDDING_DEFAULT_VELOCITY=3

# Agent Performance Configuration
# Maximum number of recent messages to keep in conversation context (default: 20)
# Set to 0 to disable message pruning. Higher values increase token usage and cost.
MESSAGE_WINDOW_SIZE=20

# Message management strategy for long conversations (default: summarize)
# - 'summarize': Use LLM-based conversation summarization. Older messages are
#   intelligently condensed into a summary, preserving context while reducing tokens.
# - 'prune': Simple window-based truncation. Only keeps the most recent messages;
#   older messages are discarded without summarization.
MESSAGE_MANAGEMENT_MODE=summarize

# Memory Configuration
# Local directory used for session-scoped short-term memory Markdown files.
MEMORY_STORAGE_DIR=./data/memory
# Maximum number of recent non-system messages copied into short-term memory.
MEMORY_SHORT_TERM_MAX_MESSAGES=12

# Python Analysis Sandbox Configuration
# Docker backend uses the internal service URL:
#   PYTHON_ANALYSIS_SANDBOX_URL=http://analysis-sandbox:8080
# Local VS Code backend debugging with the Docker sandbox uses the host-mapped port:
#   PYTHON_ANALYSIS_SANDBOX_URL=http://localhost:18080
# If 18080 is also occupied, set PYTHON_ANALYSIS_SANDBOX_HOST_PORT=18081
# and use PYTHON_ANALYSIS_SANDBOX_URL=http://localhost:18081 for local debugging.
PYTHON_ANALYSIS_SANDBOX_HOST_PORT=18080
PYTHON_ANALYSIS_SANDBOX_URL=
PYTHON_ANALYSIS_SANDBOX_TIMEOUT=35
# Feature cap per layer sent into the sandbox (raise for city-scale TopN area).
PYTHON_ANALYSIS_MAX_FEATURES_PER_LAYER=2000
PYTHON_ANALYSIS_MAX_OUTPUT_BYTES=1048576
# Per-session hard stop for sandbox retries (model recovery attempts included).
PYTHON_ANALYSIS_MAX_CALLS=5
SANDBOX_MAX_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=1048576
# Optional runtime package download settings for analysis-sandbox.
# Use docker-compose.sandbox-unrestricted.yml to run the sandbox as root with a writable filesystem.
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=

# Optional geocoding fallbacks for Chinese addresses (server-side Web service keys)
AMAP_WEB_SERVICE_KEY=
BAIDU_GEOCODING_AK=
