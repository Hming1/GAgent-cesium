# External deployment profile for the production-like Docker Compose stack.
# Copy to .env.external and replace the example origin with the public origin.
# Prefer HTTPS and COOKIE_SECURE=true for any real deployment.
BASE_URL=https://map.example.com
FRONTEND_BASE_URL=https://map.example.com
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_UPLOAD_URL=/api/upload
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
