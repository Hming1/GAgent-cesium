{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Backend (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "module": "main",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/../.env",
            "env": {
                "DATABASE_AZURE_URL": "postgresql://app:app@localhost:5432/app"
            },
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Debug Backend (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/../.env",
            "env": {
                "DATABASE_AZURE_URL": "postgresql://app:app@localhost:5432/app"
            },
            "jinja": true,
            "justMyCode": true
        }
    ]
}