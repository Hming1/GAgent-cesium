{
  "suite": "geospatial_capability_live",
  "description": "GeoAgent Agent 地理工作能力实测题库。每题给出期望工具、禁止工具、判定规则。",
  "version": "1.0",
  "cases": [
    {
      "id": "G01",
      "skill": "geocoding",
      "category": "地理编码-行政边界",
      "query": "把杭州市的行政边界加到地图上，我要的是多边形边界，不要兴趣点。",
      "expect_tools": ["geocode_nominatim"],
      "forbid_tools": ["geocode_overpass"],
      "expect_any_tool": true,
      "expect_geodata_min": 1,
      "expect_keywords": ["杭州"],
      "weight": 2,
      "rationale": "边界要素必须走 Nominatim 关系级结果，用 Overpass 搜 POI 是典型误用。"
    },
    {
      "id": "G02",
      "skill": "geocoding",
      "category": "地理编码-POI+范围约束",
      "query": "以上海人民广场为中心，找 2 公里内的医院，先告诉我数量。",
      "expect_tools": ["geocode_overpass"],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_geodata_min": 1,
      "expect_keywords": ["医院"],
      "weight": 2,
      "rationale": "考察中心点定位 + POI 检索 + 空间范围约束，且要求先做数量摘要。"
    },
    {
      "id": "G03",
      "skill": "geocoding",
      "category": "地理编码-缺参澄清",
      "query": "帮我找中学，并按办学类型分类统计。",
      "expect_tools": [],
      "forbid_tools": ["geocode_overpass", "geocode_nominatim", "geoprocess"],
      "expect_clarification": true,
      "expect_any_tool": false,
      "weight": 2,
      "rationale": "缺地点是阻塞信息，应只问一个澄清问题，而不是全球盲搜或提前调分析工具。"
    },
    {
      "id": "D01",
      "skill": "postgis",
      "category": "数据发现-模糊表名",
      "query": "数据库里有没有名字里带 park 或 公园 的空间表？先列出来，不要直接加载全部。",
      "expect_tools": ["list_postgis_layers"],
      "forbid_tools": ["load_postgis_layer"],
      "expect_any_tool": true,
      "expect_keywords": ["park", "公园"],
      "weight": 2,
      "rationale": "先发现后加载；直接 load 属于跳步。"
    },
    {
      "id": "D02",
      "skill": "postgis",
      "category": "数据发现-真实表加载",
      "query": "把深圳市的行政边界表加载到地图上。",
      "expect_tools": ["list_postgis_layers"],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_geodata_min": 1,
      "expect_keywords": ["深圳"],
      "weight": 2,
      "rationale": "layers 库中存在 layer_深圳市，考察能否列出并加载真实存在的表。"
    },
    {
      "id": "D03",
      "skill": "postgis",
      "category": "数据发现-不存在表失败恢复",
      "query": "加载 public.not_a_real_table，如果失败就从数据库里找名字最接近 park 或 road 的候选表给我选。",
      "expect_tools": ["list_postgis_layers"],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_no_fake_success": true,
      "weight": 2,
      "rationale": "考察失败可恢复：报错要可读，且不假装加载成功。"
    },
    {
      "id": "A01",
      "skill": "attributes",
      "category": "属性处理-真实表筛选",
      "query": "把数据库里深圳餐饮那张表加载出来，然后按面积或记录数做个简单统计。",
      "expect_tools": ["list_postgis_layers"],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_geodata_min": 1,
      "weight": 2,
      "rationale": "layers 库有 layer_深圳餐饮，考察加载 + 属性统计组合。"
    },
    {
      "id": "A02",
      "skill": "attributes",
      "category": "属性处理-字段探查",
      "query": "先加载深圳市的学校数据，然后筛选出小学，字段名我不确定，你先看看有哪些字段再筛。",
      "expect_tools": [],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_field_discovery": true,
      "weight": 2,
      "rationale": "字段未知时应先探查字段再筛选，不能瞎猜字段名。"
    },
    {
      "id": "P01",
      "skill": "geoprocessing",
      "category": "空间分析-缓冲区",
      "query": "把深圳市行政边界加载出来，然后做 200 米缓冲区，输出成新图层，不要覆盖原来的边界。",
      "expect_tools": ["geoprocess"],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_geodata_min": 2,
      "expect_keywords": ["缓冲", "200"],
      "weight": 3,
      "rationale": "核心空间分析能力：缓冲区算子、米制单位、输出独立图层而非覆盖。"
    },
    {
      "id": "P02",
      "skill": "geoprocessing",
      "category": "空间分析-裁剪",
      "query": "用深圳市边界裁剪深圳餐饮点，统计裁剪后还剩多少个点。",
      "expect_tools": ["geoprocess"],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_keywords": ["裁剪", "点"],
      "weight": 3,
      "rationale": "两图层叠加 + 结果计数，考察跨图层空间关系处理。"
    },
    {
      "id": "P03",
      "skill": "geoprocessing",
      "category": "空间分析-空结果诚实",
      "query": "用广东省的行政边界去裁剪深圳餐饮点，如果两者对不上或结果为空，直接告诉我原因，不要编造结果。",
      "expect_tools": [],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_no_fake_success": true,
      "weight": 3,
      "rationale": "空结果时必须解释而非伪造。广东省覆盖深圳属正常覆盖关系，考察能否正确解释“全部命中”而非谎报裁剪失败。"
    },
    {
      "id": "S01",
      "skill": "styling",
      "category": "样式-局部修改",
      "query": "把深圳市行政边界加载出来，然后把这个边界图层填充改成蓝色、40% 透明，其它图层样式不要动。",
      "expect_tools": ["style_layers"],
      "forbid_tools": ["apply_color_scheme"],
      "expect_any_tool": true,
      "weight": 2,
      "rationale": "样式是 opt-in 且只针对指定图层，全局改色是误用。单轮内完成加载+改样式，避免跨轮图层丢失干扰。"
    },
    {
      "id": "X01",
      "skill": "postgis",
      "category": "架构缺陷-图层流转",
      "setup": ["把深圳市行政边界加载到地图上"],
      "query": "现在对刚才加载的深圳边界做 100 米缓冲。",
      "expect_tools": ["geoprocess"],
      "forbid_tools": [],
      "expect_any_tool": true,
      "expect_geodata_min": 1,
      "weight": 3,
      "rationale": "专测跨轮图层可见性：上一轮加载的图层是否进入 geodata_layers 并被空间工具消费。"
    },
    {
      "id": "E01",
      "skill": "osint",
      "category": "外部数据-火点",
      "query": "看看北京最近有没有火点。",
      "expect_tools": [],
      "forbid_tools": ["geocode_overpass"],
      "expect_any_tool": true,
      "allow_config_error": true,
      "expect_keywords": ["火点"],
      "weight": 2,
      "rationale": "火点必须用 NASA FIRMS，用 Overpass 搜 POI 冒充是典型错误。本环境未配置 NASA_FIRMS_MAP_KEY，允许如实报告缺 Key 并给出替代方案。"
    },
    {
      "id": "E02",
      "skill": "osint",
      "category": "外部数据-天气",
      "query": "杭州市明天的天气怎么样？",
      "expect_tools": ["ecmwf_weather"],
      "forbid_tools": [],
      "expect_any_tool": true,
      "weight": 2,
      "rationale": "天气应走 ECMWF 工具链。"
    },
    {
      "id": "N01",
      "skill": "none",
      "category": "负例-闲聊不触发工具",
      "query": "你是谁？顺便说说你们支持 PostGIS 和缓冲分析吗？现在先不要连库、也不要跑 geoprocess。",
      "expect_tools": [],
      "forbid_tools": ["list_postgis_layers", "load_postgis_layer", "geoprocess"],
      "expect_any_tool": false,
      "weight": 2,
      "rationale": "冲突指令测试：提到工具词但明确禁止执行，应零工具调用。"
    },
    {
      "id": "N02",
      "skill": "none",
      "category": "负例-无图层时拒绝硬跑",
      "query": "对当前选中图层做个空间关系分析，可能是相交或裁剪，你看着办。",
      "expect_tools": [],
      "forbid_tools": ["geoprocess"],
      "expect_any_tool": false,
      "expect_clarification": true,
      "weight": 3,
      "rationale": "无图层 + 模糊算子，应说明缺图层并只问一个必要问题，不能伪造结果。"
    },
    {
      "id": "N03",
      "skill": "none",
      "category": "负例-过度请求收敛",
      "query": "帮我把全世界的学校都找出来，做成缓冲区，再配色，再和天气数据叠一下。",
      "expect_tools": [],
      "forbid_tools": ["geocode_overpass"],
      "expect_any_tool": false,
      "expect_clarification": true,
      "weight": 3,
      "rationale": "无界任务应被收敛，先问一个国家/城市范围，而不是开始全球检索。"
    },
    {
      "id": "M01",
      "skill": "metadata",
      "category": "元数据-能力检索",
      "query": "你们平台能做哪些空间分析操作？列出支持的分析算子。",
      "expect_tools": [],
      "forbid_tools": [],
      "expect_any_tool": false,
      "expect_keywords": ["buffer", "overlay"],
      "weight": 1,
      "rationale": "能力查询可直接依据工具 description 作答（算子名确实内嵌在工具描述里），不强制调用 search_metadata；但答案必须引用真实存在的算子名，不能编造。"
    }
  ]
}
